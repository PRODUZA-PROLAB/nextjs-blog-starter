# Modelo de variáveis de ambiente — copie para .env.local (não commitar)
# Todas as variáveis deste starter são públicas (NEXT_PUBLIC_*).

# URL pública do site (usada em metadata, RSS, sitemap e robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nome público exibido no rodapé, título e feed RSS
NEXT_PUBLIC_SITE_NAME=Next.js Blog Starter

# Descrição curta padrão usada em <meta description> e no RSS
NEXT_PUBLIC_SITE_DESCRIPTION=Um blog full-stack com Next.js 15, MDX, busca, temas e RSS.

# Autor padrão exibido nas páginas de post
NEXT_PUBLIC_SITE_AUTHOR=Produza ProLab
